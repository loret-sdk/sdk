      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx/esm --test src/__tests__/middleware.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@loret/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@ai-sdk/provider": ">=1.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.0",
    "@types/node": "^22.19.17"
  }
}
