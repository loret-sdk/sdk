{
  "name": "@loret/vercel",
  "description": "Vercel AI SDK middleware for Loret — native loop detection and recovery for all AI SDK providers",
  "license": "MIT",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loret-sdk/sdk.git"
  },
  "keywords": [
    "loret",
    "vercel",
    "ai-sdk",
    "middleware",
    "guardrails",
    "loop-detection",
    "agent",
    "llm",
    "cost-control"
  ],
  "exports": {
    ".": {
